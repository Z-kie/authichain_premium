# ============================================
# AuthiChain Vercel Environment Variables
# ============================================
# Copy these to your Vercel project settings:
# Dashboard → Project → Settings → Environment Variables

# ============================================
# Database Configuration
# ============================================
DATABASE_URL="your-production-postgresql-url"

# ============================================
# NextAuth Configuration
# ============================================
NEXTAUTH_URL="https://your-deployment-url.vercel.app"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# ============================================
# Stripe Configuration
# ============================================
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_publishable_key"

# Stripe Price IDs (15 total - from your Stripe dashboard)
STRIPE_PRICE_ID_STARTER_MONTHLY="price_starter_monthly"
STRIPE_PRICE_ID_STARTER_ANNUAL="price_starter_annual"
STRIPE_PRICE_ID_PROFESSIONAL_MONTHLY="price_professional_monthly"
STRIPE_PRICE_ID_PROFESSIONAL_ANNUAL="price_professional_annual"
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY="price_enterprise_monthly"
STRIPE_PRICE_ID_ENTERPRISE_ANNUAL="price_enterprise_annual"
STRIPE_PRICE_ID_PLATINUM_MONTHLY="price_platinum_monthly"
STRIPE_PRICE_ID_PLATINUM_ANNUAL="price_platinum_annual"
STRIPE_PRICE_ID_DIAMOND_MONTHLY="price_diamond_monthly"
STRIPE_PRICE_ID_DIAMOND_ANNUAL="price_diamond_annual"
STRIPE_PRICE_ID_ULTIMATE_MONTHLY="price_ultimate_monthly"
STRIPE_PRICE_ID_ULTIMATE_ANNUAL="price_ultimate_annual"
STRIPE_PRICE_ID_CUSTOM_MONTHLY="price_custom_monthly"
STRIPE_PRICE_ID_CUSTOM_ANNUAL="price_custom_annual"
STRIPE_PRICE_ID_ADDON="price_addon"

# ============================================
# Blockchain Configuration
# ============================================
PRIVATE_KEY="your-wallet-private-key"
POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
CONTRACT_ADDRESS="your-contract-address"
POLYGONSCAN_API_KEY="your-polygonscan-api-key"

# ============================================
# NFT.Storage Configuration
# ============================================
NFT_STORAGE_API_KEY="your-nft-storage-api-key"

# ============================================
# Cloudflare Configuration
# ============================================
CLOUDFLARE_API_TOKEN="your-cloudflare-token"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-key"
CLOUDFLARE_R2_BUCKET_NAME="your-bucket-name"
CLOUDFLARE_R2_PUBLIC_URL="your-r2-public-url"

# ============================================
# Feature Flags
# ============================================
ENABLE_BLOCKCHAIN="true"
ENABLE_IPFS="true"
ENABLE_PAYMENTS="true"
ENABLE_MARKETPLACE="true"

# ============================================
# IMPORTANT NOTES:
# ============================================
# 1. All NEXT_PUBLIC_* variables are exposed to the browser
# 2. Never commit actual secrets to git
# 3. Update NEXTAUTH_URL with your actual Vercel deployment URL
# 4. Use Stripe LIVE keys (sk_live_*, pk_live_*) for production
# 5. Configure webhook endpoint: https://your-domain.vercel.app/api/webhooks/stripe
