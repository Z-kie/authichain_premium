  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  nft             NFT           @relation(fields: [nftId], references: [id])
  bids            Bid[]

  @@index([nftId])
  @@index([sellerId])
  @@index([status])
  @@index([endTime])
  @@index([createdAt])
}

model Bid {
