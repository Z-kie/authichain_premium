generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/authichain_premium/app/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String                   @id @default(cuid())
  email                String                   @unique
  password             String
  username             String?                  @unique
  firstName            String
  lastName             String
  walletAddress        String?
  image                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  acceptTerms          Boolean                  @default(false)
  subscriptionTier     SubscriptionTier         @default(EXPLORER)
  customUsername       String?                  @unique
  isVerified           Boolean                  @default(false)
  stripeCustomerId     String?                  @unique
  role                 UserRole                 @default(CONSUMER)
  signupNumber         Int? // Track signup order for launch bonuses
  referredBy           String? // Referral code used at signup
  totalReferrals       Int                      @default(0)
  referralEarnings     Float                    @default(0)
  // Onboarding tracking
  onboardingCompleted  Boolean                  @default(false)
  tutorialCompleted    Boolean                  @default(false)
  walletConnected      Boolean                  @default(false)
  firstNFTMinted       Boolean                  @default(false)
  firstPurchaseMade    Boolean                  @default(false)
  onboardingStep       Int                      @default(0)
  accounts             Account[]
  clientCommissions    ArtCommission[]          @relation("ClientCommissions")
  artworkLikes         ArtworkLike[]
  cannabisArtist       CannabisArtist?
  createdNFTs          CannabisNFT[]            @relation("CreatedNFTs")
  ownedNFTs            CannabisNFT[]            @relation("OwnedNFTs")
  cannabisProfessional CannabisProfessional?
  nftLikes             NFTLike[]
  boughtNFTs           NFTSale[]                @relation("BoughtNFTs")
  soldNFTs             NFTSale[]                @relation("SoldNFTs")
  nftUploads           NftUpload[]
  qrScans              QRScan[]
  referralCodes        ReferralCode[]
  sessions             Session[]
  subscriptions        Subscription[]
  usageRecords         UsageRecord[]
  bonusPackages        BonusPackageAssignment[]
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  tier                 SubscriptionTier
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NftUpload {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String?
  imageUrl        String
  tokenId         String?
  contractAddress String?
  blockchain      String    @default("ethereum")
  status          NftStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model UsageRecord {
  id        String    @id @default(cuid())
  userId    String
  action    UsageType
  count     Int       @default(1)
  month     Int
  year      Int
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, month, year])
  @@index([userId, month, year])
}

model MarketingLead {
  id                     String               @id @default(cuid())
  email                  String               @unique
  source                 String
  campaign               String
  lastCampaign           String
  lastSource             String
  touchCount             Int                  @default(1)
  status                 LeadStatus           @default(ACTIVE)
  tags                   String[]
  lastConversion         String?
  lastConversionValue    Float?
  lastConversionDate     DateTime?
  firstName              String?
  lastName               String?
  interests              String[]             @default([])
  leadScore              Int                  @default(0)
  lifecycleStage         String               @default("LEAD")
  lastEngagementDate     DateTime?
  totalEngagements       Int                  @default(0)
  averageEngagementScore Float                @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  events                 MarketingEvent[]
  downloads              LeadMagnetDownload[]

  @@index([email])
  @@index([campaign])
  @@index([createdAt])
}

model MarketingEvent {
  id               String         @id @default(cuid())
  email            String?
  event            String
  campaign         String
  source           String
  value            Float          @default(0)
  subscriptionTier String?
  metadata         Json?
  createdAt        DateTime       @default(now())
  lead             MarketingLead? @relation(fields: [email], references: [email])

  @@index([event])
  @@index([campaign])
  @@index([createdAt])
}

model MarketingCampaign {
  id             String         @id @default(cuid())
  name           String         @unique
  type           CampaignType
  status         CampaignStatus @default(ACTIVE)
  description    String?
  targetRevenue  Float?
  actualRevenue  Float          @default(0)
  conversionGoal String
  startDate      DateTime       @default(now())
  endDate        DateTime?
  settings       Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([type])
  @@index([status])
}

model ReferralCode {
  id            String                 @id @default(cuid())
  code          String                 @unique
  userId        String?
  type          ReferralType           @default(USER)
  commission    Float                  @default(0.2)
  usageCount    Int                    @default(0)
  totalEarnings Float                  @default(0)
  isActive      Boolean                @default(true)
  expiresAt     DateTime?
  createdAt     DateTime               @default(now())
  user          User?                  @relation(fields: [userId], references: [id])
  referrals     ReferralConversion[]
  performance   AffiliatePerformance[]

  @@index([code])
  @@index([userId])
}

model ReferralConversion {
  id               String           @id @default(cuid())
  referralCodeId   String
  convertedEmail   String
  subscriptionTier String
  revenue          Float
  commission       Float
  status           ConversionStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  referralCode     ReferralCode     @relation(fields: [referralCodeId], references: [id])

  @@index([referralCodeId])
  @@index([convertedEmail])
}

model CannabisStrain {
  id              String            @id @default(cuid())
  name            String            @unique
  type            StrainType
  description     String?
  imageUrl        String?
  genetics        Json
  heritage        Json
  characteristics Json
  rarityScore     Float             @default(50)
  isVerified      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  nfts            CannabisNFT[]
  packages        CannabisPackage[]

  @@index([type])
  @@index([rarityScore])
  @@index([isVerified])
}

model CannabisPackage {
  id                  String               @id @default(cuid())
  packageId           String               @unique
  qrCode              String               @unique
  strainId            String
  growerId            String
  harvestDate         DateTime
  packageDate         DateTime
  expirationDate      DateTime
  netWeight           Float
  batchNumber         String
  labTestId           String?
  stateTrackingNumber String?
  location            Json?
  cultivationData     Json?
  status              PackageStatus        @default(ACTIVE)
  scannedCount        Int                  @default(0)
  lastScanned         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  nfts                CannabisNFT[]
  grower              CannabisProfessional @relation("GrowerPackages", fields: [growerId], references: [id])
  labTest             LabTest?             @relation(fields: [labTestId], references: [id])
  strain              CannabisStrain       @relation(fields: [strainId], references: [id])
  scans               QRScan[]
  seedToSaleEvents    SeedToSaleEvent[]

  @@index([packageId])
  @@index([strainId])
  @@index([growerId])
  @@index([harvestDate])
  @@index([status])
}

model CannabisNFT {
  id                  String           @id @default(cuid())
  tokenId             String           @unique
  name                String
  description         String?
  imageUrl            String
  animationUrl        String?
  metadataUrl         String?
  packageId           String
  strainId            String
  creatorId           String
  ownerId             String
  artistId            String?
  blockchain          String           @default("ethereum")
  contractAddress     String?
  price               Float?
  currency            String           @default("ETH")
  rarityScore         Float            @default(50)
  rarityRank          Int?
  traits              Json
  royaltyPercentage   Float            @default(0)
  isMinted            Boolean          @default(false)
  mintTransactionHash String?
  status              NftStatus        @default(ACTIVE)
  viewCount           Int              @default(0)
  likeCount           Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  artist              CannabisArtist?  @relation(fields: [artistId], references: [id])
  creator             User             @relation("CreatedNFTs", fields: [creatorId], references: [id])
  owner               User             @relation("OwnedNFTs", fields: [ownerId], references: [id])
  package             CannabisPackage  @relation(fields: [packageId], references: [id])
  strain              CannabisStrain   @relation(fields: [strainId], references: [id])
  likes               NFTLike[]
  sales               NFTSale[]
  royaltyPayments     RoyaltyPayment[]

  @@index([tokenId])
  @@index([packageId])
  @@index([creatorId])
  @@index([ownerId])
  @@index([rarityScore])
  @@index([createdAt])
}

model LabTest {
  id             String            @id @default(cuid())
  testNumber     String            @unique
  testDate       DateTime
  labId          String
  packageId      String?
  batchNumber    String
  cannabinoids   Json
  terpenes       Json?
  contaminants   Json?
  moisture       Float?
  waterActivity  Float?
  certificateUrl String?
  qrCodeData     String?
  status         TestStatus        @default(PENDING)
  isPublic       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  packages       CannabisPackage[]
  lab            LabPartner        @relation(fields: [labId], references: [id])

  @@index([testNumber])
  @@index([labId])
  @@index([testDate])
  @@index([status])
}

model SeedToSaleEvent {
  id              String                @id @default(cuid())
  packageId       String
  stage           SeedToSaleStage
  timestamp       DateTime
  location        String?
  operatorLicense String?
  operatorId      String?
  notes           String?
  gpsCoordinates  Json?
  environmentData Json?
  photoUrls       String[]
  blockchainHash  String?
  isVerified      Boolean               @default(false)
  createdAt       DateTime              @default(now())
  operator        CannabisProfessional? @relation(fields: [operatorId], references: [id])
  package         CannabisPackage       @relation(fields: [packageId], references: [id])

  @@index([packageId])
  @@index([stage])
  @@index([timestamp])
  @@index([operatorId])
}

model CannabisProfessional {
  id               String             @id @default(cuid())
  userId           String?            @unique
  businessName     String
  licenseNumber    String             @unique
  licenseType      LicenseType
  licenseExpiry    DateTime
  contactEmail     String
  contactPhone     String?
  address          Json
  status           ProfessionalStatus @default(PENDING)
  isVerified       Boolean            @default(false)
  verificationDate DateTime?
  monthlyPackages  Int                @default(0)
  totalRevenue     Float              @default(0)
  rating           Float              @default(0)
  reviewCount      Int                @default(0)
  profileImageUrl  String?
  bannerImageUrl   String?
  description      String?
  specialties      String[]
  certifications   Json?
  socialLinks      Json?
  joinedDate       DateTime           @default(now())
  lastActive       DateTime           @default(now())
  packages         CannabisPackage[]  @relation("GrowerPackages")
  user             User?              @relation(fields: [userId], references: [id])
  seedToSaleEvents SeedToSaleEvent[]

  @@index([licenseNumber])
  @@index([licenseType])
  @@index([status])
  @@index([isVerified])
}

model CannabisArtist {
  id              String           @id @default(cuid())
  userId          String?          @unique
  artistName      String           @unique
  bio             String?
  walletAddress   String?
  portfolioUrl    String?
  socialLinks     Json?
  specializations String[]
  experienceLevel ArtistLevel      @default(BEGINNER)
  totalArtworks   Int              @default(0)
  totalRoyalties  Float            @default(0)
  averageRating   Float            @default(0)
  reviewCount     Int              @default(0)
  isVerified      Boolean          @default(false)
  isActive        Boolean          @default(true)
  commissionRate  Float            @default(10)
  minCommission   Float            @default(50)
  profileImageUrl String?
  bannerImageUrl  String?
  featuredWorkUrl String?
  joinedDate      DateTime         @default(now())
  lastActive      DateTime         @default(now())
  commissions     ArtCommission[]
  artworks        Artwork[]
  user            User?            @relation(fields: [userId], references: [id])
  nfts            CannabisNFT[]
  royaltyPayments RoyaltyPayment[]

  @@index([artistName])
  @@index([isVerified])
  @@index([isActive])
  @@index([totalRoyalties])
}

model Artwork {
  id            String          @id @default(cuid())
  title         String
  description   String?
  imageUrl      String
  thumbnailUrl  String?
  artistId      String
  category      ArtworkCategory
  tags          String[]
  isForSale     Boolean         @default(false)
  price         Float?
  currency      String          @default("USD")
  licenseType   LicenseType     @default(EXCLUSIVE)
  usageRights   Json?
  dimensions    Json?
  fileFormat    String?
  fileSize      Int?
  isNSFW        Boolean         @default(false)
  downloadCount Int             @default(0)
  likeCount     Int             @default(0)
  viewCount     Int             @default(0)
  status        ArtworkStatus   @default(PUBLISHED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  commissions   ArtCommission[]
  artist        CannabisArtist  @relation(fields: [artistId], references: [id])
  likes         ArtworkLike[]

  @@index([artistId])
  @@index([category])
  @@index([isForSale])
  @@index([status])
  @@index([createdAt])
}

model ArtCommission {
  id                String           @id @default(cuid())
  clientId          String
  artistId          String
  artworkId         String?
  title             String
  description       String
  budget            Float
  currency          String           @default("USD")
  deadline          DateTime?
  status            CommissionStatus @default(PENDING)
  paymentStatus     PaymentStatus    @default(PENDING)
  artworkFiles      Json?
  revisionCount     Int              @default(0)
  maxRevisions      Int              @default(3)
  communicationLog  Json?
  contractUrl       String?
  finalPrice        Float?
  paidAmount        Float?
  royaltyPercentage Float?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  completedAt       DateTime?
  artist            CannabisArtist   @relation(fields: [artistId], references: [id])
  artwork           Artwork?         @relation(fields: [artworkId], references: [id])
  client            User             @relation("ClientCommissions", fields: [clientId], references: [id])

  @@index([clientId])
  @@index([artistId])
  @@index([status])
  @@index([paymentStatus])
}

model QRScan {
  id            String          @id @default(cuid())
  packageId     String
  scannerId     String?
  scannerIp     String
  deviceInfo    Json?
  location      Json?
  timestamp     DateTime        @default(now())
  wasSuccessful Boolean         @default(true)
  nftCreated    Boolean         @default(false)
  nftId         String?
  package       CannabisPackage @relation(fields: [packageId], references: [id])
  scanner       User?           @relation(fields: [scannerId], references: [id])

  @@index([packageId])
  @@index([scannerId])
  @@index([timestamp])
}

model RoyaltyPayment {
  id                String         @id @default(cuid())
  nftId             String
  artistId          String
  amount            Float
  currency          String         @default("ETH")
  transactionHash   String?
  blockchainNetwork String         @default("ethereum")
  paymentDate       DateTime       @default(now())
  status            PaymentStatus  @default(PENDING)
  saleId            String?
  artist            CannabisArtist @relation(fields: [artistId], references: [id])
  nft               CannabisNFT    @relation(fields: [nftId], references: [id])
  sale              NFTSale?       @relation(fields: [saleId], references: [id])

  @@index([nftId])
  @@index([artistId])
  @@index([paymentDate])
  @@index([status])
}

model NFTSale {
  id                String           @id @default(cuid())
  nftId             String
  sellerId          String
  buyerId           String?
  price             Float
  currency          String           @default("ETH")
  transactionHash   String?
  blockchainNetwork String           @default("ethereum")
  saleDate          DateTime         @default(now())
  status            SaleStatus       @default(LISTED)
  marketplaceFee    Float            @default(0)
  royaltyFee        Float            @default(0)
  buyer             User?            @relation("BoughtNFTs", fields: [buyerId], references: [id])
  nft               CannabisNFT      @relation(fields: [nftId], references: [id])
  seller            User             @relation("SoldNFTs", fields: [sellerId], references: [id])
  royaltyPayments   RoyaltyPayment[]

  @@index([nftId])
  @@index([sellerId])
  @@index([buyerId])
  @@index([saleDate])
  @@index([status])
}

model NFTLike {
  id        String      @id @default(cuid())
  nftId     String
  userId    String
  createdAt DateTime    @default(now())
  nft       CannabisNFT @relation(fields: [nftId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([nftId, userId])
  @@index([nftId])
  @@index([userId])
}

model ArtworkLike {
  id        String   @id @default(cuid())
  artworkId String
  userId    String
  createdAt DateTime @default(now())
  artwork   Artwork  @relation(fields: [artworkId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([artworkId, userId])
  @@index([artworkId])
  @@index([userId])
}

model WhiteLabelClient {
  id               String                  @id @default(cuid())
  name             String
  domain           String?                 @unique
  logo             String?
  status           WhiteLabelStatus        @default(SETUP)
  tier             SubscriptionTier        @default(ENTERPRISE)
  locations        Int                     @default(1)
  monthlyRevenue   Float                   @default(0)
  setupFee         Float                   @default(0)
  monthlyFee       Float                   @default(499)
  customBranding   Boolean                 @default(true)
  apiAccess        Boolean                 @default(true)
  mobileApp        Boolean                 @default(false)
  dedicatedSupport Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  integrations     WhiteLabelIntegration[]

  @@index([status])
  @@index([tier])
}

model WhiteLabelIntegration {
  id               String            @id @default(cuid())
  whiteLabelId     String
  integrationType  String
  status           IntegrationStatus @default(PENDING)
  apiEndpoint      String?
  credentials      Json?
  monthlyUsage     Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  whiteLabelClient WhiteLabelClient  @relation(fields: [whiteLabelId], references: [id])

  @@index([whiteLabelId])
  @@index([integrationType])
}

model ApiUsage {
  id       String   @id @default(cuid())
  clientId String
  endpoint String
  calls    Int      @default(0)
  revenue  Float    @default(0)
  tier     ApiTier  @default(DEVELOPER)
  date     DateTime @default(now())
  metadata Json?

  @@index([clientId])
  @@index([endpoint])
  @@index([date])
}

model DispensaryPartner {
  id              String        @id @default(cuid())
  name            String
  logo            String?
  locations       Int           @default(1)
  monthlyScans    Int           @default(0)
  revenue         Float         @default(0)
  status          PartnerStatus @default(ACTIVE)
  partnershipType String        @default("STANDARD")
  contactEmail    String?
  integrationDate DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([partnershipType])
}

model LabPartner {
  id              String        @id @default(cuid())
  name            String
  monthlyTests    Int           @default(0)
  revenue         Float         @default(0)
  integrationType String        @default("API")
  status          PartnerStatus @default(ACTIVE)
  accuracy        Float         @default(0.0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  labTests        LabTest[]

  @@index([status])
  @@index([integrationType])
}

model LaunchBonus {
  id         String           @id @default(cuid())
  userId     String
  bonusType  LaunchBonusType
  tier       SubscriptionTier
  claimed    Boolean          @default(true)
  claimedAt  DateTime         @default(now())
  bonusValue Int              @default(0)
  expiresAt  DateTime?
  resources  Json? // List of bonus resources/content
  metadata   Json?

  @@index([userId])
  @@index([bonusType])
  @@index([tier])
}

model CommercialLicense {
  id                String                @id @default(cuid())
  userId            String
  licenseType       CommercialLicenseType
  licenseKey        String                @unique
  issuedAt          DateTime              @default(now())
  expiresAt         DateTime?
  clientLimit       Int                   @default(5)
  whiteLabelEnabled Boolean               @default(false)
  isActive          Boolean               @default(true)
  metadata          Json?

  @@index([userId])
  @@index([licenseType])
  @@index([licenseKey])
}

model AffiliatePartner {
  id               String          @id @default(cuid())
  userId           String?
  name             String
  email            String          @unique
  status           AffiliateStatus @default(PENDING)
  commissionRate   Float           @default(0.3)
  totalEarnings    Float           @default(0)
  totalConversions Int             @default(0)
  payoutThreshold  Float           @default(100)
  availableBalance Float           @default(0)
  paidBalance      Float           @default(0)
  affiliateCode    String          @unique
  website          String?
  socialLinks      Json?
  notes            String?
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([affiliateCode])
}

// ====================================
// ADDITIONAL MODELS FOR COMPLETE MARKETPLACE FUNCTIONALITY
// ====================================

model Transaction {
  id              String            @id @default(cuid())
  userId          String?
  transactionType TransactionType
  amount          Float
  currency        String            @default("USD")
  status          TransactionStatus @default(PENDING)
  paymentMethod   PaymentMethod     @default(STRIPE)
  stripePaymentId String?
  stripeSessionId String?
  cryptoAddress   String?
  cryptoTxHash    String?
  description     String?
  metadata        Json?
  referenceId     String? // Reference to related entity (NFT, Subscription, etc.)
  referenceType   String? // Type of reference (nft, subscription, etc.)
  escrowId        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  completedAt     DateTime?
  failedAt        DateTime?
  errorMessage    String?
  escrow          Escrow?           @relation(fields: [escrowId], references: [id])
  cryptoPayment   CryptoPayment?

  @@index([userId])
  @@index([transactionType])
  @@index([status])
  @@index([stripePaymentId])
  @@index([cryptoTxHash])
  @@index([referenceId])
  @@index([createdAt])
}

model Escrow {
  id               String        @id @default(cuid())
  transactionId    String?
  buyerId          String
  sellerId         String
  amount           Float
  currency         String        @default("USD")
  status           EscrowStatus  @default(CREATED)
  releaseCondition String? // Description of release conditions
  buyerApproved    Boolean       @default(false)
  sellerApproved   Boolean       @default(false)
  adminApproved    Boolean       @default(false)
  releasedAmount   Float?
  disputeReason    String?
  resolutionNotes  String?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  releasedAt       DateTime?
  disputedAt       DateTime?
  resolvedAt       DateTime?
  transactions     Transaction[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
