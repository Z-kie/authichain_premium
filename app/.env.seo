
# SEO and Analytics Environment Variables
# Add these to your main .env file for SEO optimization

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://authichain.app
NEXT_PUBLIC_SITE_NAME="AuthiChain"

# Google Services
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
GOOGLE_VERIFICATION_ID=your-google-verification-id

# Social Media Analytics
NEXT_PUBLIC_FB_PIXEL_ID=your-facebook-pixel-id
FACEBOOK_VERIFICATION_ID=your-facebook-domain-verification

# Optional Analytics Services
NEXT_PUBLIC_CLARITY_ID=your-microsoft-clarity-id
NEXT_PUBLIC_HOTJAR_ID=your-hotjar-id

# Search Console & Webmaster Tools
BING_VERIFICATION_ID=your-bing-webmaster-verification
YANDEX_VERIFICATION_ID=your-yandex-webmaster-verification

# Performance Monitoring
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# Social Media Handles (for structured data)
TWITTER_HANDLE=@AuthiChain
FACEBOOK_PAGE=https://facebook.com/authichain
LINKEDIN_COMPANY=https://linkedin.com/company/authichain
INSTAGRAM_HANDLE=@authichain_official

# Industry-specific SEO (Optional - can be removed or customized)
# COMPLIANCE_REGION=US
# AGE_VERIFICATION=18
# LEGAL_DISCLAIMER=true
